{
  "name": "claude-token-star",
  "version": "2.6.1",
  "description": "Live star overlay that visualizes Claude Code context usage.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "claude-token-star": "bin/claude-token-star.mjs"
  },
  "files": [
    "bin/claude-token-star.mjs",
    "bin/python-runtime.mjs",
    "bin/project-root.mjs",
    "assets/preview",
    "scripts/windows/install.cmd",
    "scripts/windows/token-test.cmd",
    "scripts/windows/uninstall.cmd",
    "src/ghostty/install.sh",
    "src/ghostty/supernova.glsl",
    "src/ghostty/token-mass.py",
    "src/ghostty/token-test.sh",
    "src/ghostty/uninstall.sh",
    "src/shared/claude-settings.example.json",
    "src/shared/claude-settings.windows.example.json",
    "src/windows/install.ps1",
    "src/windows/supernova-windows.hlsl",
    "src/windows/token-mass-windows.ps1",
    "src/windows/token-star-overlay.ps1",
    "src/windows/uninstall.ps1",
    "tools/preview.html",
    "tools/preview-renderer.js",
    "tools/capture-preview-assets.ps1",
    "tools/preview.ps1",
    "tools/token-test.ps1",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "VERSION"
  ],
  "scripts": {
    "test": "npm run test:cli && npm run test:shader",
    "test:cli": "node tests/test-cli.mjs",
    "test:shader": "node tests/compile-shader.mjs",
    "test:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/test-windows.ps1",
    "test:hlsl": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/compile-hlsl.ps1"
